          "pattern": "^[a-z0-9_-]+$"
        },
        "type": {
          "const": "review"
        },
        "label": {
          "type": "string",
          "pattern": "\\S"
        },
        "help": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "recommendation": {
          "type": "string",
          "pattern": "\\S",
          "description": "one line: what the agent recommends and why; shown with the question"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "detail": {
                "type": "string",
                "pattern": "\\S",
                "description": "markdown behind a per-item Detail toggle (a diff fence for a change)"
              },
              "recommended": {
                "type": "string",
                "description": "one of decisions"
              }
            },
            "additionalProperties": false
          }
        },
        "decisions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [
            "approve",
            "revise",
            "reject"
          ]
        },
        "comment": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
