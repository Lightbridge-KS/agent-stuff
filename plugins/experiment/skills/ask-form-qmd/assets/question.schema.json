{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ask-form-qmd question v1",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "id",
        "type",
        "label",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "type": {
          "const": "single_select"
        },
        "label": {
          "type": "string",
          "pattern": "\\S"
        },
        "help": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "recommendation": {
          "type": "string",
          "pattern": "\\S",
          "description": "one line: what the agent recommends and why; shown with the question"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "detail": {
                "type": "string",
                "pattern": "\\S",
                "description": "constrained rich Markdown in an expandable detail block; reading only"
              },
              "recommended": {
                "type": "boolean",
                "description": "badge this option; at most one per single_select; not for ranking"
              }
            },
            "additionalProperties": false
          },
          "contains": {
            "type": "object",
            "required": [
              "recommended"
            ],
            "properties": {
              "recommended": {
                "const": true
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        "allow_other": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "id",
        "type",
        "label",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "type": {
          "const": "multi_select"
        },
        "label": {
          "type": "string",
          "pattern": "\\S"
        },
        "help": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "recommendation": {
          "type": "string",
          "pattern": "\\S",
          "description": "one line: what the agent recommends and why; shown with the question"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": "string",
