                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "detail": {
                "type": "string",
                "pattern": "\\S",
                "description": "constrained rich Markdown in an expandable detail block; reading only"
              },
              "recommended": {
                "type": "boolean",
                "description": "badge this option; at most one per single_select; not for ranking"
              }
            },
            "additionalProperties": false
          }
        },
        "allow_other": {
          "type": "boolean",
          "default": true
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "id",
        "type",
        "label",
        "min",
        "max"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "type": {
          "const": "scale"
        },
        "label": {
          "type": "string",
          "pattern": "\\S"
        },
        "help": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "recommendation": {
          "type": "string",
          "pattern": "\\S",
          "description": "one line: what the agent recommends and why; shown with the question"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "recommended": {
          "type": "number",
          "description": "marked on the slider; never preselected"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "id",
        "type",
        "label",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "type": {
          "const": "ranking"
        },
        "label": {
          "type": "string",
          "pattern": "\\S"
        },
        "help": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "recommendation": {
          "type": "string",
          "pattern": "\\S",
          "description": "one line: what the agent recommends and why; shown with the question"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "detail": {
                "type": "string",
                "pattern": "\\S",
                "description": "constrained rich Markdown in an expandable detail block; reading only"
              },
              "recommended": {
                "const": false,
                "description": "ranking has no recommended option; the given order is the recommendation"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "id",
        "type",
        "label"
      ],
