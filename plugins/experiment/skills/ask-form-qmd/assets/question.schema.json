          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string"
        },
        "recommended": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    {
