        "required": {
          "type": "boolean"
        },
        "recommendation": {
          "type": "string",
          "pattern": "\\S",
          "description": "one line: what the agent recommends and why; shown with the question"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "detail": {
                "type": "string",
                "pattern": "\\S",
                "description": "constrained rich Markdown in an expandable detail block; reading only"
              },
              "recommended": {
