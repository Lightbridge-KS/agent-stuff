{
  "name": "explorable-document-runtime",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": "26.7.x"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
