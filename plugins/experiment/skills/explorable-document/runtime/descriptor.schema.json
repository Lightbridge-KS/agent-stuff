{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "summary", "entry", "interactions"],
  "properties": {
    "schema_version": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "entry": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_/-]+\\.(mdx|tsx)$",
      "maxLength": 200
    },
    "layout": { "enum": ["article", "workspace"] },
    "assets": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 200 }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema"],
      "properties": { "schema": { "type": "string", "maxLength": 200 } }
    },
    "data_sources": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "kind", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "kind": { "enum": ["synthetic", "illustrative", "sourced"] },
          "description": { "type": "string", "maxLength": 4000 },
          "reference": { "type": "string", "maxLength": 2000 },
          "units": { "type": "string", "maxLength": 200 },
          "version": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "interactions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "trigger", "input_schema", "outputs", "expected"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "trigger": { "type": "string", "minLength": 1, "maxLength": 500 },
          "input_schema": { "type": "object" },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "$ref": "#/definitions/id" }
          },
          "expected": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
      "maxLength": 64
    }
  }
}
