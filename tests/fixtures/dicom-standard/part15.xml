  <chapter label="1" status="1" xml:id="chapter_1">
    <title>Scope and Field of Application</title>
    <para xml:id="para_11">This part specifies security profiles. See <xref linkend="sect_E.1" xrefstyle="select: label"/> and <olink targetdoc="PS3.3" targetptr="PS3.3" xrefstyle="select: labelnumber"/>.</para>
    <section label="1.1" status="2" xml:id="sect_1.1">
      <title>Scope</title>
      <para xml:id="para_111">Profiles cover:</para>
      <itemizedlist>
        <listitem><para xml:id="para_112">Secure transport connections</para></listitem>
        <listitem><para xml:id="para_113">Attribute confidentiality</para></listitem>
      </itemizedlist>
      <note>
        <para xml:id="para_114">Nothing here is normative in the fixture.</para>
      </note>
    </section>
  </chapter>
  <chapter label="E" status="1" xml:id="chapter_E">
    <title>Attribute Confidentiality Profiles (Normative)</title>
    <section label="E.1" status="2" xml:id="sect_E.1">
      <title>Application Level Confidentiality Profile</title>
      <para xml:id="para_e1a">The profile addresses <emphasis role="bold">data confidentiality</emphasis> at the application layer, using the data elements of <olink targetdoc="PS3.6" targetptr="sect_6" xrefstyle="select: labelnumber"/>.</para>
      <orderedlist>
        <listitem>
          <para xml:id="para_e1b">Remove identifying Attributes.</para>
          <itemizedlist>
            <listitem><para xml:id="para_e1c">Replace with a dummy value where Type 1.</para></listitem>
          </itemizedlist>
        </listitem>
        <listitem><para xml:id="para_e1d">Record the profile applied.</para></listitem>
      </orderedlist>
      <variablelist>
        <varlistentry>
          <term>D</term>
          <listitem><para xml:id="para_e1e">replace with a non-zero length dummy value</para></listitem>
        </varlistentry>
        <varlistentry>
          <term>Z</term>
          <listitem><para xml:id="para_e1f">replace with a zero length value, or a dummy value if Type 1</para></listitem>
        </varlistentry>
      </variablelist>
      <para xml:id="para_e1g">Encoded example:</para>
      <programlisting>(0010,0010) PN [Anonymous^Patient]</programlisting>
      <para xml:id="para_e1h">See the IHE profile at <link xl:href="https://example.org/ihe">example.org</link>.</para>
      <para xml:id="para_e1i">
