      <section label="E.1.1" status="3" xml:id="sect_E.1.1">
        <title>De-identifier</title>
        <para xml:id="para_e111">A De-identifier shall remove or replace the Attributes listed in <xref linkend="table_E.1-1" xrefstyle="select: label"/>, and may apply the options in <xref linkend="sect_E.1.2"/>.</para>
        <para xml:id="para_e112">Values that are <emphasis>not</emphasis> listed are kept.</para>
      </section>
      <section label="E.1.2" status="3" xml:id="sect_E.1.2">
        <title>Re-identifier</title>
        <para xml:id="para_e121">A Re-identifier restores values from a secure mapping.</para>
      </section>
    </section>
